publish/
PublishOutput/

# ─── .NET RUNTIME / SDK ──────────────────────────────────────
project.lock.json
project.fragment.lock.json
artifacts/
*.nuget.props
*.nuget.targets
*.FileContentIndex
*.dswa.cache.json
rjsmrazor.*.json

# ─── ASP.NET CORE ────────────────────────────────────────────
# Không commit appsettings chứa thông tin nhạy cảm
# appsettings.json   ← GIỮ LẠI (chứa cấu hình chung)
appsettings.*.json  # Nếu muốn bỏ qua tất cả môi trường
!appsettings.json
!appsettings.Development.json

# Secrets
**/secrets.json
**/usersecrets.json

# ─── ENTITY FRAMEWORK MIGRATIONS BUILD ───────────────────────
# Giữ lại thư mục Migrations nhưng bỏ qua snapshot tạm
*.mdf
*.ldf
*.ndf

# ─── NODE / FRONTEND ─────────────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output
dist/
dist-ssr/
*.local

# TypeScript cache
*.tsbuildinfo

# ─── EDITOR / IDE ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
