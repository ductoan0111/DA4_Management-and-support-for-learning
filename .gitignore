# ============================================================
#  .gitignore – DA4 Management and Support for Learning
#  Backend: ASP.NET Core (.NET 10)
#  Frontend: React + TypeScript (Vite)
# ============================================================

# ─── VISUAL STUDIO ───────────────────────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.filters
*.VC.db
*.VC.VC.opendb
DocumentLayout.json
DocumentLayout.backup.json
*.backup.json
applicationhost.config

# ─── .NET BUILD OUTPUT ───────────────────────────────────────
